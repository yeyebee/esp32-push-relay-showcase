#pragma once

// 이 파일을 secrets.h 로 복사한 뒤 실제 값으로 채우세요. secrets.h 는 git 에 올라가지 않습니다.
//   cp src/secrets.h.example src/secrets.h          (PlatformIO)
//   cp src/secrets.h.example PushRelay/secrets.h    (Arduino IDE 스케치)

static const char* WIFI_SSID = "<your-wifi-ssid>";
static const char* WIFI_PASS = "<your-wifi-password>";
static const char* API_KEY   = "<api-key>";  // 서버에서 조회: grep ^API_KEY= api-server/.env

// 서버 베이스 URL. 끝에 슬래시 없이. 매크로인 이유는 컴파일 타임 문자열 리터럴 연결
// (PUSH_BASE_URL "/ingest") 로 엔드포인트를 만들기 때문 — 런타임 비용 0.
#define PUSH_BASE_URL "https://<push-host>"
